{
  "name": "stilura",
  "version": "0.6.3",
  "description": "A local AI-assisted editor for sharper, more human writing",
  "keywords": [
    "writing",
    "editor",
    "ai",
    "prose",
    "markdown",
    "local"
  ],
  "license": "MIT",
  "author": "Vadim Chirkov",
  "homepage": "https://github.com/vadimchirkov/stilura#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vadimchirkov/stilura.git"
  },
  "bugs": "https://github.com/vadimchirkov/stilura/issues",
  "type": "module",
  "main": "index.js",
  "bin": {
    "stilura": "index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "tasks.js",
    "brief.js",
    "chat-edits.js",
    "pi.js",
    "markdown.js",
    "review.js",
    "document-store.js",
    "desktop.js",
    "storage-migration.js",
    "editing.js",
    "notes.js",
    "live-session.js",
    "session-client.js",
    "text-change.js",
    "work.js",
    "suggestions.js",
    "public",
    "skills/stilura/SKILL.md",
    "style.md",
    "SPEC.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "start": "node index.js",
    "build": "esbuild src/app.js --bundle --outfile=public/app.js --format=iife",
    "build:server": "node scripts/build-server.mjs",
    "desktop:prepare": "npm run build && npm run build:server && node scripts/fetch-node.mjs",
    "desktop": "tauri dev",
    "desktop:build": "tauri build",
    "tauri": "tauri",
    "smoke:desktop": "node scripts/smoke-desktop.mjs",
    "check": "node --check index.js && node --check pi.js && node --check tasks.js && npm run build && node selfcheck.js && node tests/suggestions.mjs && node tests/generation.mjs && node tests/passage.mjs && node tests/generation-http.mjs && node tests/tasks-http.mjs && node tests/live.mjs && node tests/work.mjs && node tests/live-http.mjs && node tests/oauth.mjs && node safetycheck.js && node tests/storage-migration.mjs && node tests/persistence.mjs && node tests/ui.mjs",
    "test:browser": "node tests/browser-fixture.mjs",
    "check:suggestions": "node tests/suggestions.mjs",
    "eval:suggestions": "node scripts/evaluate-suggestions.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@codemirror/collab": "^6.1.1",
    "@codemirror/state": "^6.7.6",
    "@earendil-works/pi-ai": "^0.87.1",
    "@earendil-works/pi-coding-agent": "^0.87.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "codemirror": "^6.0.1",
    "dictionary-en": "^4.0.0",
    "esbuild": "^0.28.2",
    "nspell": "^2.1.5"
  }
}
