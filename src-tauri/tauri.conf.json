{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Litura",
  "version": "../package.json",
  "identifier": "io.github.vadimchirkov.litura",
  "build": {
    "frontendDist": "shell",
    "beforeDevCommand": "npm run desktop:prepare",
    "beforeBuildCommand": "npm run desktop:prepare"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "copyright": "MIT",
    "shortDescription": "A local AI-assisted editor for sharper, more human writing",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/litura-server"],
    "resources": {
      "../dist/server.mjs": "server.mjs",
      "../package.json": "package.json",
      "../style.md": "style.md",
      "../public/": "public/"
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/vadimchirkov/litura/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2MjBFRkUxREJCNTBCNDMKUldSREM3WGI0ZThnZGh2UERFazFpRlNBUm5tVzVscmttMmxaL2o0Q2FYTGh3eGFHU1Y1S3RDb0cK"
    }
  }
}
